# Copy this file to .env.local and fill in the values.
# Anything prefixed with VITE_ is exposed to client-side code.

# Where to POST credit card applications.
# The form sends JSON: { card, fullName, email, phone, reason, submittedAt }
# If left empty, submissions are logged to the browser console (useful for local dev).
VITE_CARD_APPLICATION_WEBHOOK=
