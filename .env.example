# Copy this file to .env.local and fill in the values.
#
# IMPORTANT: anything prefixed with VITE_ is compiled into the public browser
# bundle and is readable by anyone who views the site. Never put a secret,
# key or private webhook behind a VITE_ prefix.
#
# The variables below have NO prefix on purpose — they are read only by the
# serverless functions in api/, which run on the server.

# ---------------------------------------------------------------------------
# Supabase — backs /api/careers and /api/contact
# ---------------------------------------------------------------------------
# Use a Supabase project dedicated to website form submissions and nothing else.
# Run supabase/schema.sql in that project's SQL Editor first.

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Service role key (Project Settings -> API -> service_role).
# This key bypasses Row Level Security. Treat it like a database password:
# server-side only, never committed, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Private storage bucket for CVs. Defaults to "cvs" if unset.
SUPABASE_CV_BUCKET=cvs

# Private storage bucket for award images. Defaults to "awards" if unset.
SUPABASE_AWARDS_BUCKET=awards

# ---------------------------------------------------------------------------
# Admin page (/admin)
# ---------------------------------------------------------------------------
# Admins normally sign in with their own email and password; accounts and roles
# are managed inside /admin itself. Run supabase/schema.sql first to create the
# admin_users and admin_roles tables.

# Break-glass owner password. Minimum 10 characters, or it is treated as unset.
# Signing in with this and no email grants every page. It exists so the first
# account can be created and so a role edit that removes everyone's access can
# be undone. Keep it set, keep it to yourself, and use a personal account for
# day-to-day work — a shared password cannot be traced to a person.
ADMIN_PASSWORD=

# Optional. Signs admin session cookies. Falls back to a value derived from
# SUPABASE_SERVICE_ROLE_KEY when unset, so it is safe to leave blank.
# Changing it signs everyone out immediately, which is how you revoke every
# session at once without touching individual accounts.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Scheduled job (/api/cron)
# ---------------------------------------------------------------------------
# Runs daily per vercel.json and makes one trivial query, so a free-tier
# Supabase project never sits idle long enough to auto-pause. A paused project
# stops resolving in DNS and takes the careers form, contact form and admin
# down together. Delete the cron entry from vercel.json if the project moves
# to Supabase Pro, which does not auto-pause.
#
# Set this to any long random string. Vercel sends it as a Bearer token on
# scheduled runs; the endpoint verifies it when set, so nobody else can
# trigger the job.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Credit card application dialog (currently unused — the "Get this card"
# button is commented out in src/pages/Index.tsx)
# ---------------------------------------------------------------------------
# Where to POST credit card applications.
# The form sends JSON: { card, fullName, phone, submittedAt }
# If left empty, submissions are logged to the browser console.
# NOTE: this is a VITE_ variable, so whatever URL you set here is publicly
# visible in the bundle. Prefer moving it to an api/ function like the others.
VITE_CARD_APPLICATION_WEBHOOK=
